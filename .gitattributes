* text=auto
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.png binary
*.jpg binary
*.pdf binary
*.pptx binary
*.woff2 binary

# Preserve the exact generated bytes used by catalog hashes and report provenance.
site/assets/explorer/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
site/data/explorer/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
